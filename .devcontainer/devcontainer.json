{
    "name": "DevContainer",
    "image": "docker.io/madebytimo/development",
    "remoteUser": "user",
    "runArgs": ["--tmpfs", "/tmp:exec"],
    "remoteEnv": {
        "PATH": "${containerEnv:PATH}:/media/user/.local/bin",
        "PIP_BREAK_SYSTEM_PACKAGES": "true"
    },
    "mounts": [
        { "type": "volume", "target": "/media/user", "source": "dev-simulation-software-engineering-exercise-diffusion2d-home" }
    ],
    "postCreateCommand": {
        "pip": "pip3-latest install build matplotlib numpy twine"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "mhutchie.git-graph",
                "ms-python.python",
                "streetsidesoftware.code-spell-checker",
                "streetsidesoftware.code-spell-checker-german"
            ]
        }
    }
}
